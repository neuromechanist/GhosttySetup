#!/usr/bin/env bash
# Theme watcher for Ghostty
#
# Watches the OS appearance (dark/light) and rewrites the theme-aware keys in
# the active Ghostty config so split dividers and unfocused split fill match
# the system mode. Cursor contrast is handled statically by Ghostty 1.2.0+
# (cursor-color = cell-foreground, cursor-text = cell-background), so this
# watcher no longer touches cursor keys.
#
# Supported platforms:
#   - macOS:        appearance via `defaults read -g AppleInterfaceStyle`
#   - Linux/GNOME:  appearance via `gsettings get org.gnome.desktop.interface color-scheme`

set -euo pipefail

OS="$(uname -s)"
CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/ghostty-theme-watcher/current-theme"
POLL_INTERVAL="${GHOSTTY_THEME_POLL_INTERVAL:-2}"

mkdir -p "$(dirname "$CACHE_FILE")"

# --- Platform glue ----------------------------------------------------------

# Resolve the active Ghostty config file in load order. Prefer the new
# `config.ghostty` filename (Ghostty 1.2.3+) and fall back to legacy `config`.
resolve_config_file() {
    local candidates=()
    case "$OS" in
        Darwin)
            # macOS-specific path is loaded after XDG and overrides it, so this
            # is the one to edit.
            candidates+=(
                "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
                "$HOME/Library/Application Support/com.mitchellh.ghostty/config"
            )
            ;;
        Linux)
            local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
            candidates+=(
                "$xdg/ghostty/config.ghostty"
                "$xdg/ghostty/config"
            )
            ;;
        *)
            echo "Unsupported OS: $OS" >&2
            return 1
            ;;
    esac

    for path in "${candidates[@]}"; do
        if [ -f "$path" ]; then
            printf '%s\n' "$path"
            return 0
        fi
    done

    # Fall back to the first candidate so set_config_value can create it.
    printf '%s\n' "${candidates[0]}"
}

# Detect current appearance: prints "dark" or "light".
get_appearance() {
    case "$OS" in
        Darwin)
            if defaults read -g AppleInterfaceStyle &>/dev/null; then
                echo "dark"
            else
                echo "light"
            fi
            ;;
        Linux)
            local scheme=""
            if command -v gsettings >/dev/null 2>&1; then
                scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)"
            fi
            case "$scheme" in
                *prefer-dark*) echo "dark" ;;
                *prefer-light*|*default*|"") echo "light" ;;
                *) echo "light" ;;
            esac
            ;;
        *)
            echo "light"
            ;;
    esac
}

# In-place sed across BSD (macOS) and GNU (Linux) without leaking temp suffixes.
sed_inplace() {
    case "$OS" in
        Darwin) sed -i '' "$@" ;;
        *)      sed -i    "$@" ;;
    esac
}

# --- Config rewriting -------------------------------------------------------

set_config_value() {
    local key="$1"
    local value="$2"
    local file="$3"

    if [ ! -f "$file" ]; then
        mkdir -p "$(dirname "$file")"
        : > "$file"
    fi

    if grep -q "^${key} = " "$file"; then
        sed_inplace "s|^${key} = .*|${key} = ${value}|" "$file"
    else
        printf '%s = %s\n' "$key" "$value" >> "$file"
    fi
}

update_config() {
    local appearance="$1"
    local file="$2"
    local color
    if [ "$appearance" = "dark" ]; then
        color="#f0f0f0"
    else
        color="#0f0f0f"
    fi

    set_config_value "split-divider-color"  "$color" "$file"
    set_config_value "unfocused-split-fill" "$color" "$file"
}

# --- Main loop --------------------------------------------------------------

config_file="$(resolve_config_file)"
echo "Starting Ghostty theme watcher on $OS"
echo "Watching: $config_file"
echo "Manual restart of Ghostty (Cmd+Q on macOS) is needed for split colors to apply."

current_appearance="$(get_appearance)"
printf '%s\n' "$current_appearance" > "$CACHE_FILE"
update_config "$current_appearance" "$config_file"
echo "Initial theme: $current_appearance"

while true; do
    sleep "$POLL_INTERVAL"

    new_appearance="$(get_appearance)"

    if [ "$new_appearance" != "$current_appearance" ]; then
        echo "Appearance changed: $current_appearance -> $new_appearance"
        current_appearance="$new_appearance"
        printf '%s\n' "$current_appearance" > "$CACHE_FILE"
        update_config "$current_appearance" "$config_file"
        echo "Config updated. Restart Ghostty to apply changes."
    fi
done
